
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>BLOCK BATTLE</title>
<style>
*{box-sizing:border-box;touch-action:none}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#111827;color:white;font-family:Arial,sans-serif}
button{font-family:inherit;font-weight:bold;color:white;border:0;cursor:pointer}
#menu{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;gap:4vw;padding:3vw;background:linear-gradient(130deg,#121b32,#20254b 60%,#112e3c);overflow:hidden}
.brand{width:35%;text-align:center}
.logo{font-size:clamp(30px,7vw,66px);font-weight:1000;line-height:.95;letter-spacing:2px;color:#f5f7ff;text-shadow:4px 4px #267cbb}
.brand p{font-size:clamp(10px,1.8vw,15px);color:#a9cce8;letter-spacing:2px}
.pixel-show{display:flex;justify-content:center;align-items:center;gap:20px;margin:22px 0}
.pixel{width:42px;height:42px;image-rendering:pixelated;position:relative;background:#168fce;box-shadow:inset 0 0 0 5px #65d9ff}
.pixel:before{content:"";position:absolute;left:7px;top:10px;width:7px;height:7px;background:#101827;box-shadow:17px 0 #101827}
.pixel:after{content:"";position:absolute;left:13px;top:26px;width:16px;height:5px;background:#101827}
.pixel.red{background:#d83d59;box-shadow:inset 0 0 0 5px #ff8496}
.modes{width:56%;display:flex;gap:16px;align-items:stretch;justify-content:center}
.mode{flex:1;min-width:0;max-width:290px;text-align:left;padding:clamp(12px,2.3vw,22px);border-radius:12px;background:#1a2740;border:2px solid #3c587a;display:flex;flex-direction:column;justify-content:space-between;gap:10px}
.mode.knock{border-color:#b64d6b;background:#302039}
.mode h2{font-size:clamp(16px,2.5vw,25px);margin:5px 0}
.mode p{font-size:clamp(10px,1.4vw,13px);line-height:1.45;color:#d0dcec;margin:5px 0;flex:1}
.mode .symbol{font-size:clamp(25px,4vw,38px)}
.play{width:100%;padding:12px 5px;border-radius:7px;background:#168bd0;font-size:clamp(11px,1.5vw,14px);touch-action:manipulation}
.knock .play{background:#d53e66}
#game{display:none;position:fixed;inset:0;background:#192637}
canvas{display:block;width:100%;height:100%}
#hud{position:absolute;top:7px;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none;text-shadow:1px 2px #000;white-space:nowrap}
#modeLabel{font-size:11px;font-weight:bold;color:#b7eaff}
#score{font-size:21px;font-weight:1000;margin-top:3px}
#hint{font-size:10px;margin-top:2px}
#back{position:absolute;left:7px;top:7px;padding:9px 12px;border-radius:6px;background:#283951;touch-action:manipulation}
#stick{position:absolute;left:18px;bottom:18px;width:105px;height:105px;border-radius:50%;background:#ffffff22;border:2px solid #ffffff66}
#knob{position:absolute;left:29px;top:29px;width:43px;height:43px;border-radius:50%;background:#d8e7f0;border:2px solid white}
#fire{position:absolute;right:22px;bottom:27px;width:75px;height:75px;border-radius:50%;background:#df3d58;border:3px solid #ff9aaa;font-size:12px}
#overlay{display:none;position:absolute;inset:0;background:#08101ddd;align-items:center;justify-content:center;text-align:center}
#panel{background:#1c2b45;border:2px solid #6285ad;border-radius:12px;padding:22px;width:min(80%,340px)}
#result{font-size:25px;margin:8px}
.action{width:100%;padding:12px;margin-top:8px;background:#168bd0;border-radius:7px;touch-action:manipulation}
#musicButton{position:absolute;right:7px;top:7px;padding:9px 10px;border-radius:6px;background:#283951;touch-action:manipulation;font-size:11px}
@media(orientation:portrait){
#menu:after{content:"TELEFONUNU YATAY ÇEVİR";position:absolute;inset:0;background:#111827;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;text-align:center}
#game:after{content:"TELEFONUNU YATAY ÇEVİR";position:absolute;inset:0;background:#111827;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;text-align:center;z-index:10}
}
</style>
</head>
<body>
<div id="menu">
 <div class="brand">
  <div class="logo">BLOCK<br>BATTLE</div>
  <p>PIXEL TEAM BATTLE</p>
  <div class="pixel-show"><div class="pixel"></div><div style="font-size:22px">VS</div><div class="pixel red"></div></div>
 </div>
 <div class="modes">
  <div class="mode">
   <div>
    <div class="symbol">⚔</div>
    <h2>KLASİK</h2>
    <p>4'e 4 savaş. İlk 20 elemeye ulaş. Elenince 15 saniye sonra yeniden doğ.</p>
   </div>
   <button class="play" onclick="startGame('classic')">OYNA ▶</button>
  </div>
  <div class="mode knock">
   <div>
    <div class="symbol">☠</div>
    <h2>NAKAVT</h2>
    <p>4'e 4 takım savaşı. Yeniden doğma yok. Üç tur kazanan maçı alır.</p>
   </div>
   <button class="play" onclick="startGame('knockout')">OYNA ▶</button>
  </div>
 </div>
</div>

<div id="game">
 <canvas id="canvas"></canvas>
 <div id="hud">
  <div id="modeLabel">KLASİK</div>
  <div id="score">🔵 0 - 0 🔴</div>
  <div id="hint">İlk 20 elemeye ulaş!</div>
 </div>
 <button id="back" onclick="goMenu()">MENÜ</button>
 <button id="musicButton" onclick="toggleMusic()">♫ MÜZİK: AÇIK</button>
 <div id="stick"><div id="knob"></div></div>
 <button id="fire">ATEŞ</button>
 <div id="overlay"><div id="panel">
  <div id="result">KAZANDIN!</div>
  <p id="resultText"></p>
  <button class="action" onclick="restartGame()">TEKRAR OYNA</button>
  <button class="action" onclick="goMenu()" style="background:#465775">ANA MENÜ</button>
 </div></div>
</div>

<script>
const canvas=document.getElementById("canvas"),ctx=canvas.getContext("2d");
const menu=document.getElementById("menu"),game=document.getElementById("game");
const scoreEl=document.getElementById("score"),hint=document.getElementById("hint");
const overlay=document.getElementById("overlay");
let W=0,H=0,dpr=1,mode="classic",units=[],bullets=[],blocks=[];
let blue=0,red=0,blueRounds=0,redRounds=0,round=1;
let running=false,ended=false,roundOver=false,roundWait=0,last=0;
let mx=0,my=0,shooting=false,stickId=null;

/* ÖZGÜN RETRO CHİPTUNE MÜZİK */
let musicCtx=null,musicTimer=null,musicStep=0,musicEnabled=true;
const melody=[
196,0,196,294,330,0,294,220,
196,0,165,196,247,0,220,196,
147,0,147,220,247,0,220,165,
196,247,294,0,330,294,247,0,
262,0,330,392,349,0,330,294,
247,0,294,330,262,0,220,196,
165,196,220,247,294,0,247,220,
196,0,147,165,196,0,196,0
];
const bass=[98,98,110,110,82,82,98,98,73,73,87,87,98,98,82,82];

function musicNote(freq,duration,type,volume,when){
 if(!freq||!musicCtx)return;
 const osc=musicCtx.createOscillator();
 const gain=musicCtx.createGain();
 osc.type=type;
 osc.frequency.setValueAtTime(freq,when);
 gain.gain.setValueAtTime(.0001,when);
 gain.gain.exponentialRampToValueAtTime(volume,when+.012);
 gain.gain.exponentialRampToValueAtTime(.0001,when+duration);
 osc.connect(gain);gain.connect(musicCtx.destination);
 osc.start(when);osc.stop(when+duration+.02);
}
function startMusic(){
 if(!musicEnabled)return;
 if(!musicCtx){
  const AC=window.AudioContext||window.webkitAudioContext;
  if(!AC)return;
  musicCtx=new AC();
 }
 if(musicCtx.state==="suspended")musicCtx.resume();
 if(musicTimer)return;
 musicTimer=setInterval(()=>{
  if(!musicCtx||musicCtx.state!=="running"||!musicEnabled)return;
  const t=musicCtx.currentTime+.02;
  const i=musicStep%melody.length;
  musicNote(melody[i],.15,"square",.035,t);
  if(musicStep%4===0){
   musicNote(bass[Math.floor(musicStep/4)%bass.length],.28,"triangle",.055,t);
  }
  if(musicStep%8===6){
   musicNote(440,.045,"square",.012,t);
  }
  musicStep++;
 },180);
}
function stopMusic(){
 if(musicTimer){clearInterval(musicTimer);musicTimer=null;}
}
function toggleMusic(){
 musicEnabled=!musicEnabled;
 document.getElementById("musicButton").textContent="♫ MÜZİK: "+(musicEnabled?"AÇIK":"KAPALI");
 if(musicEnabled)startMusic();else stopMusic();
}
function unlockMusic(){
 if(musicEnabled)startMusic();
}
document.addEventListener("pointerdown",unlockMusic);
document.addEventListener("keydown",unlockMusic);

function resize(){
 W=window.innerWidth;H=window.innerHeight;
 dpr=Math.min(window.devicePixelRatio||1,2);
 canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);
 canvas.style.width=W+"px";canvas.style.height=H+"px";
 ctx.setTransform(dpr,0,0,dpr,0,0);
}
window.addEventListener("resize",resize);
resize();

function makeBlocks(){
 blocks=[];
 const data=[
 [.27,.25,.075,.12],[.65,.25,.075,.12],
 [.27,.64,.075,.12],[.65,.64,.075,.12],
 [.43,.18,.14,.07],[.43,.75,.14,.07],
 [.44,.43,.055,.14],[.51,.43,.055,.14]
 ];
 for(const b of data)blocks.push({x:b[0]*W,y:b[1]*H,w:b[2]*W,h:b[3]*H});
}
function hitsBlock(x,y,r){
 return blocks.some(b=>x+r>b.x&&x-r<b.x+b.w&&y+r>b.y&&y-r<b.y+b.h);
}
function spawn(team,i){
 return {x:team===0?W*.12:W*.88,y:H*(.34+i*.105)};
}
function createUnit(team,i){
 const p=spawn(team,i);
 return {team,i,x:p.x,y:p.y,hp:100,alive:true,respawn:0,
 angle:team===0?0:Math.PI,r:Math.max(9,Math.min(14,H*.027)),
 speed:Math.min(165,H*.48),cool:Math.random()*.5,
 ai:0,dx:0,dy:0};
}
function setup(){
 units=[];
 for(let i=0;i<4;i++)units.push(createUnit(0,i));
 for(let i=0;i<4;i++)units.push(createUnit(1,i));
 bullets=[];
}
function startGame(m){
 unlockMusic();
 mode=m;menu.style.display="none";game.style.display="block";
 overlay.style.display="none";resize();
 blue=red=blueRounds=redRounds=0;round=1;
 ended=false;running=true;beginRound();
 last=performance.now();requestAnimationFrame(loop);
}
function restartGame(){
 unlockMusic();
 blue=red=blueRounds=redRounds=0;round=1;ended=false;
 overlay.style.display="none";running=true;beginRound();
 last=performance.now();requestAnimationFrame(loop);
}
function goMenu(){
 running=false;ended=true;game.style.display="none";menu.style.display="flex";
 overlay.style.display="none";mx=my=0;shooting=false;
}
function beginRound(){
 roundOver=false;roundWait=0;makeBlocks();setup();
 document.getElementById("modeLabel").textContent=mode==="classic"?"KLASİK MOD":"NAKAVT • TUR "+round;
 hint.textContent=mode==="classic"?"Ölünce 15 saniye sonra doğarsın":"Yeniden doğma yok • 3 tur kazan";
 updateScore();
}
function updateScore(){
 scoreEl.textContent=mode==="classic"?"🔵 "+blue+" - "+red+" 🔴":"🔵 "+blueRounds+" TUR - "+redRounds+" TUR 🔴";
}
function finish(winner){
 if(ended)return;
 ended=true;running=false;
 document.getElementById("result").textContent=winner===0?"MAVİ TAKIM KAZANDI":"KIRMIZI TAKIM KAZANDI";
 document.getElementById("resultText").textContent=mode==="classic"?
 "Maç skoru: "+blue+" - "+red:"Tur skoru: "+blueRounds+" - "+redRounds;
 overlay.style.display="flex";
}
function checkKnockout(){
 if(mode!=="knockout"||roundOver||ended)return;
 const b=units.some(u=>u.team===0&&u.alive);
 const r=units.some(u=>u.team===1&&u.alive);
 if(!b||!r){
  roundOver=true;roundWait=2;
  if(b)blueRounds++;else redRounds++;
  updateScore();
 }
}
function move(u,dx,dy,dt){
 const len=Math.hypot(dx,dy);
 if(len<.01)return;
 dx=dx/len*u.speed*dt;dy=dy/len*u.speed*dt;
 let nx=Math.max(u.r,Math.min(W-u.r,u.x+dx));
 if(!hitsBlock(nx,u.y,u.r))u.x=nx;
 let ny=Math.max(u.r,Math.min(H-u.r,u.y+dy));
 if(!hitsBlock(u.x,ny,u.r))u.y=ny;
}
function enemyFor(u){
 let best=null,dmin=Infinity;
 for(const v of units){
  if(!v.alive||v.team===u.team)continue;
  const d=Math.hypot(v.x-u.x,v.y-u.y);
  if(d<dmin){dmin=d;best=v;}
 }
 return best;
}
function fire(u,t){
 if(u.cool>0||!t)return;
 const a=Math.atan2(t.y-u.y,t.x-u.x);
 u.angle=a;
 const speed=Math.min(440,W*.9);
 bullets.push({x:u.x+Math.cos(a)*(u.r+5),y:u.y+Math.sin(a)*(u.r+5),
 vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,team:u.team,life:1.5});
 u.cool=u.i===0&&u.team===0?.28:.7+Math.random()*.25;
}
function updateUnit(u,dt){
 if(!u.alive){
  if(mode==="classic"&&!roundOver&&!ended){
   u.respawn-=dt;
   if(u.respawn<=0){
    const p=spawn(u.team,u.i);u.x=p.x;u.y=p.y;u.hp=100;u.alive=true;
   }
  }
  return;
 }
 u.cool=Math.max(0,u.cool-dt);
 const t=enemyFor(u);if(!t)return;
 const dx=t.x-u.x,dy=t.y-u.y,d=Math.hypot(dx,dy)||1;
 u.angle=Math.atan2(dy,dx);
 if(u.team===0&&u.i===0){
  move(u,mx,my,dt);
  if(shooting)fire(u,t);
 }else{
  u.ai-=dt;
  if(u.ai<=0){
   u.ai=.3+Math.random()*.4;
   if(d>W*.3){u.dx=dx/d;u.dy=dy/d;}
   else if(d<W*.15){u.dx=-dx/d;u.dy=-dy/d;}
   else{
    const side=Math.random()<.5?1:-1;
    u.dx=-dy/d*side;u.dy=dx/d*side;
   }
  }
  const ox=u.x,oy=u.y;
  move(u,u.dx,u.dy,dt);
  if(ox===u.x&&oy===u.y){u.dx=-u.dy;u.dy=u.dx;}
  if(d<W*.65)fire(u,t);
 }
}
function updateBullets(dt){
 for(let i=bullets.length-1;i>=0;i--){
  const b=bullets[i];b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
  let remove=b.life<=0||b.x<0||b.x>W||b.y<0||b.y>H||hitsBlock(b.x,b.y,3);
  if(!remove){
   for(const u of units){
    if(!u.alive||u.team===b.team)continue;
    if(Math.hypot(u.x-b.x,u.y-b.y)<u.r+4){
     u.hp-=35;remove=true;
     if(u.hp<=0){
      u.alive=false;u.respawn=15;
      if(mode==="classic"){
       if(b.team===0)blue++;else red++;
       updateScore();
       if(blue>=20||red>=20)finish(blue>=20?0:1);
      }
      checkKnockout();
     }
     break;
    }
   }
  }
  if(remove)bullets.splice(i,1);
 }
}
function update(dt){
 if(ended)return;
 if(roundOver){
  roundWait-=dt;
  if(roundWait<=0){
   if(blueRounds>=3||redRounds>=3){finish(blueRounds>=3?0:1);return;}
   round++;beginRound();
  }
  return;
 }
 for(const u of units)updateUnit(u,dt);
 updateBullets(dt);
}
function pixelUnit(u){
 const x=Math.round(u.x),y=Math.round(u.y),s=u.r;
 const blueTeam=u.team===0;
 const main=blueTeam?"#219bd7":"#d83e59";
 const light=blueTeam?"#75ddff":"#ff9aaa";
 const dark="#111827";
 ctx.save();
 ctx.translate(x,y);
 ctx.fillStyle=dark;ctx.fillRect(-s-2,-s-2,s*2+4,s*2+5);
 ctx.fillStyle=main;ctx.fillRect(-s,-s,s*2,s*2);
 ctx.fillStyle=light;ctx.fillRect(-s,-s,s*2,Math.max(3,Math.floor(s*.35)));
 ctx.fillStyle=dark;
 ctx.fillRect(-Math.floor(s*.55),-Math.floor(s*.05),Math.max(3,Math.floor(s*.3)),Math.max(3,Math.floor(s*.3)));
 ctx.fillRect(Math.floor(s*.2),-Math.floor(s*.05),Math.max(3,Math.floor(s*.3)),Math.max(3,Math.floor(s*.3)));
 ctx.fillStyle=dark;
 ctx.fillRect(-s+2,s-1,Math.max(3,Math.floor(s*.55)),4);
 ctx.fillRect(Math.floor(s*.15),s-1,Math.max(3,Math.floor(s*.55)),4);
 ctx.rotate(u.angle);
 ctx.fillStyle=dark;ctx.fillRect(s-1,-3,s+8,6);
 ctx.fillStyle=light;ctx.fillRect(s+5,-2,5,4);
 ctx.restore();
 ctx.fillStyle="#10131b";ctx.fillRect(x-s,y-s-7,s*2,3);
 ctx.fillStyle=u.hp>50?"#62ed8b":"#ffd04d";
 ctx.fillRect(x-s,y-s-7,s*2*Math.max(0,u.hp/100),3);
 if(u.team===0&&u.i===0){
  ctx.fillStyle="white";ctx.font="bold 10px Arial";ctx.textAlign="center";
  ctx.fillText("SEN",x,y-s-10);
 }
}
function draw(){
 ctx.clearRect(0,0,W,H);
 ctx.fillStyle="#1c2b3a";ctx.fillRect(0,0,W,H);
 ctx.strokeStyle="#ffffff0b";ctx.lineWidth=1;
 for(let x=0;x<W;x+=32){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
 for(let y=0;y<H;y+=32){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
 ctx.fillStyle="#188bce15";ctx.fillRect(0,0,W*.2,H);
 ctx.fillStyle="#df345315";ctx.fillRect(W*.8,0,W*.2,H);
 for(const b of blocks){
  ctx.fillStyle="#101a29";ctx.fillRect(b.x+3,b.y+4,b.w,b.h);
  ctx.fillStyle="#52687c";ctx.fillRect(b.x,b.y,b.w,b.h);
  ctx.fillStyle="#849caf";ctx.fillRect(b.x,b.y,b.w,4);
  ctx.fillStyle="#34495c";ctx.fillRect(b.x,b.y+b.h-4,b.w,4);
 }
 for(const b of bullets){
  ctx.fillStyle=b.team===0?"#8ceaff":"#ff9ba9";
  ctx.fillRect(Math.round(b.x)-3,Math.round(b.y)-3,6,6);
 }
 for(const u of units){
  if(u.alive)pixelUnit(u);
  else if(mode==="classic"&&!ended){
   ctx.fillStyle="#fff";ctx.font="bold 11px Arial";ctx.textAlign="center";
   ctx.fillText(Math.max(0,Math.ceil(u.respawn))+"s",u.x,u.y);
  }
 }
 if(roundOver&&!ended){
  ctx.fillStyle="#08101dbb";ctx.fillRect(0,0,W,H);
  ctx.fillStyle="white";ctx.font="bold 26px Arial";ctx.textAlign="center";
  ctx.fillText(units.some(u=>u.team===0&&u.alive)?"TUR SENİN!":"TUR GİTTİ!",W/2,H/2);
 }
}
function loop(now){
 if(!running)return;
 const dt=Math.min((now-last)/1000,.035);last=now;
 update(dt);draw();
 if(running)requestAnimationFrame(loop);
}

const stick=document.getElementById("stick"),knob=document.getElementById("knob");
function joystick(e){
 const r=stick.getBoundingClientRect();
 let dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);
 const len=Math.hypot(dx,dy)||1,max=30;
 if(len>max){dx=dx/len*max;dy=dy/len*max;}
 mx=dx/max;my=dy/max;
 knob.style.left=(29+dx)+"px";knob.style.top=(29+dy)+"px";
}
function resetStick(){
 stickId=null;mx=my=0;knob.style.left="29px";knob.style.top="29px";
}
stick.addEventListener("pointerdown",e=>{
 e.preventDefault();stickId=e.pointerId;stick.setPointerCapture(e.pointerId);joystick(e);
});
stick.addEventListener("pointermove",e=>{if(e.pointerId===stickId)joystick(e);});
stick.addEventListener("pointerup",resetStick);
stick.addEventListener("pointercancel",resetStick);
const fireBtn=document.getElementById("fire");
fireBtn.addEventListener("pointerdown",e=>{e.preventDefault();shooting=true;});
fireBtn.addEventListener("pointerup",()=>shooting=false);
fireBtn.addEventListener("pointercancel",()=>shooting=false);
fireBtn.addEventListener("pointerleave",()=>shooting=false);
window.addEventListener("keydown",e=>{
 if(e.key==="ArrowUp"||e.key==="w")my=-1;
 if(e.key==="ArrowDown"||e.key==="s")my=1;
 if(e.key==="ArrowLeft"||e.key==="a")mx=-1;
 if(e.key==="ArrowRight"||e.key==="d")mx=1;
 if(e.code==="Space")shooting=true;
});
window.addEventListener("keyup",e=>{
 if(["ArrowUp","ArrowDown","w","s"].includes(e.key))my=0;
 if(["ArrowLeft","ArrowRight","a","d"].includes(e.key))mx=0;
 if(e.code==="Space")shooting=false;
});
</script>
</body>
</html
